rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * Helper functions
     */
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    /*
     * USER PROFILES
     *
     * Users can read their own profile.
     * Users may create their own profile during registration.
     *
     * IMPORTANT:
     * Balance and gold holdings cannot be changed directly
     * by the client.
     */
    match /users/{userId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid;

      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.balance == resource.data.balance
        && request.resource.data.totalGoldGrams == resource.data.totalGoldGrams;

      allow delete: if false;


      /*
       * PURCHASE ORDERS
       *
       * Browser can create a payment-pending order.
       * Browser cannot mark it paid or completed.
       */
      match /orders/{orderId} {

        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == "PENDING_PAYMENT"
          && request.resource.data.quantity > 0
          && request.resource.data.goldGrams > 0;

        allow update: if false;

        allow delete: if false;
      }


      /*
       * TRANSACTION LEDGER
       *
       * Client can read its own transactions.
       *
       * Client may create only a PENDING_PAYMENT transaction.
       * It cannot create completed/minted transactions.
       */
      match /transactions/{transactionId} {

        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.type == "PURCHASE"
          && request.resource.data.status == "PENDING_PAYMENT"
          && request.resource.data.amount > 0
          && request.resource.data.goldGrams > 0;

        allow update: if false;

        allow delete: if false;
      }


      /*
       * VAULT BARS
       *
       * These represent physical gold allocations.
       *
       * Users can READ their own allocated bars.
       * Users cannot create, modify or delete bars.
       *
       * In the real system these must be created by trusted
       * backend/admin processes after physical allocation.
       */
      match /vaultBars/{barId} {

        allow read: if isOwner(userId);

        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }


      /*
       * REDEMPTION REQUESTS
       *
       * User can create a request.
       * User can read their own requests.
       *
       * Completion/cancellation must be backend controlled.
       */
      match /redemptions/{redemptionId} {

        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == "REQUESTED"
          && request.resource.data.goldGrams > 0;

        allow update: if false;

        allow delete: if false;
      }
    }


    /*
     * MARKET DATA
     *
     * Public/read-only market information.
     *
     * Nobody using the browser can change the gold price.
     */
    match /market/{documentId} {

      allow read: if signedIn();

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }


    /*
     * BLOCKCHAIN / PUBLIC LEDGER DATA
     *
     * Read-only from the frontend.
     *
     * Real mint/transfer records must be written by
     * trusted backend infrastructure.
     */
    match /blockchain/{documentId} {

      allow read: if signedIn();

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }


    /*
     * EVERYTHING ELSE
     *
     * Deny by default.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
